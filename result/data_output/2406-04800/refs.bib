  language = {en},
  pages = {531–534},
  month = {May},
  year = {2006},
  author = {Frith, Chris D. and Frith, Uta},
  journal = {Neuron},
  number = {4},
  doi = {10.1016/j.neuron.2006.05.001},
  issn = {08966273},
  volume = {50},
  title = {The Neural Basis of Mentalizing},
