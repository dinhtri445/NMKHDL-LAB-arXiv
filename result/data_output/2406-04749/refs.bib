@article{sym14081640,
  abstract = {The stochastic modification and irreducible modification in PageRank produce large web link changes correspondingly. To get a minimal irreducible web link adjustment, a PageRank model of minimal irreducible adjustment and its lumping method are discussed by Li, Chen, and Song. In this paper, we provide alternative proofs for the minimal irreducible PageRank by a new type of similarity transformation matrices. To further provide theorems and fast algorithms on a reduced matrix, an 4×4 block matrix partition case of the minimal irreducible PageRank model is utilized and analyzed. For some real applications of our results, a lumping algorithm used for speeding up PageRank vector computations is also presented. Numerical results are also reported to show the efficiency of the proposed algorithm.},
  doi = {https://doi.org/10.3390/sym14081640},
  issn = {2073-8994},
  article-number = {1640},
  number = {8},
  year = {2022},
  volume = {14},
  journal = {Symmetry},
  title = {A Note on a Minimal Irreducible Adjustment Pagerank},
  author = {Feng, Yue-Hua and Dong, Yong-Xin and You, Jian-Xin},
}

@article{WEN201787,
  abstract = {Computing PageRank plays an important part in determining the importance of Web pages. Based on the classical power method and the inner–outer iteration proposed by Gleich et al. (2010), Gu et al. (2015) presented a two-step splitting iteration, i.e., the power-inner–outer (PIO) iteration, for the computation of PageRank. In this paper, we develop a variant of the PIO iteration by applying multi-step power method to combine with the inner–outer iteration. The new method is denoted as the MPIO iteration, its convergence is analyzed in detail. Numerical experiments on several PageRank problems are used to illustrate the effectiveness of the MPIO iteration.},
  doi = {https://doi.org/10.1016/j.cam.2016.10.020},
  keywords = {PageRank, Power method, Inner–outer method, Convergence},
  author = {Chun Wen and Ting-Zhu Huang and Zhao-Li Shen},
  issn = {0377-0427},
  year = {2017},
  pages = {87-97},
  volume = {315},
  journal = {Journal of Computational and Applied Mathematics},
  title = {A note on the two-step matrix splitting iteration for computing PageRank},
}

