@article{antoniperello2021water,
  doi = {10.3390/w13081024},
  abstract = {In this paper, we present an agent-based model for exploring the interplay of basic structural and socio-cognitive factors and conventional water saving measures in the evolution of domestic water use in metropolitan areas. Using data of Barcelona, we discuss three scenarios that involve plausible demographic and cultural trends. Results show that, in the three scenarios, aggregate outcomes are consistent with available conventional modelling (while total water use grows, per capita water use declines); however, the agent-based simulation also reveals, for each scenario, the different dynamics of simple policy measures with population growth, cultural trends and social influence; thus providing unexpected insights for policy design.},
  issn = {2073-4441},
  url = {https://www.mdpi.com/2073-4441/13/8/1024},
  article-number = {1024},
  number = {8},
  year = {2021},
  volume = {13},
  journal = {Water},
  title = {Modelling Domestic Water Use in Metropolitan Areas Using Socio-Cognitive Agents},
  author = {Perello-Moragues, Antoni and Poch, Manel and Sauri, David and Popartan, Lucia Alexandra and Noriega, Pablo},
}

