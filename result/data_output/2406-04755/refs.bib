  xxkeywords = {replication, p-fishing, nhst controversy, harking, file drawer effect, experimental preregistration},
  xxnumpages = {12},
  xxpages = {1–12},
  booktitle = {Proceedings of the 2018 CHI Conference on Human Factors in Computing Systems},
  xxabstract = {Experimental preregistration is required for publication in many scientific disciplines and venues. When experimental intentions are preregistered, reviewers and readers can be confident that experimental evidence in support of reported hypotheses is not the result of HARKing, which stands for Hypothesising After the Results are Known. We review the motivation and outcomes of experimental preregistration across a variety of disciplines, as well as previous work commenting on the role of evaluation in HCI research. We then discuss how experimental preregistration could be adapted to the distinctive characteristics of Human-Computer Interaction empirical research, to the betterment of the discipline.},
  xxdoi = {10.1145/3173574.3173715},
  xxurl = {https://doi.org/10.1145/3173574.3173715},
