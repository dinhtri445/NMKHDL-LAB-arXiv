@article{zyla_generation_2017,
  file = {Full Text PDF:/Users/gordonzyla/Zotero/storage/SWKVHSA3/Zyla et al. - 2017 - Generation of bioinspired structural colors via tw.pdf:application/pdf},
  pages = {17622},
  keywords = {Biomimetics, Biophotonics, Lithography, Nanostructures},
  year = {2017},
  month = {December},
  author = {Zyla, Gordon and Kovalev, Alexander and Grafen, Markus and Gurevich, Evgeny L. and Esen, Cemal and Ostendorf, Andreas and Gorb, Stanislav},
  journal = {Sci. Rep.},
  urldate = {2023-05-31},
  number = {1},
  language = {en},
  abstract = {Colors of crystals, pigments, metals, salt solutions and bioluminescence occur in nature due to the optical properties of electrons in atoms and molecules. However, colors can also result from interference effects on nanostructures. In contrast to artificial coloration, which are caused by well-defined regular structures, the structural colors of living organisms are often more intense and almost angle-independent. In this paper, we report the successful manufacturing of a lamellar nanostructure that mimics the ridge shape of the Morpho butterfly using a 3d-direct laser writing technique. The viewing angle dependency of the color was analyzed via a spectrometer and the structure was visualized using a scanning electron microscope. The generated nano- and micro-structures and their optical properties were comparable to those observed in the Morpho butterfly.},
  doi = {10.1038/s41598-017-17914-w},
  url = {https://www.nature.com/articles/s41598-017-17914-w},
  issn = {2045-2322},
  copyright = {2017 The Author(s)},
  volume = {7},
  title = {Generation of bioinspired structural colors via two-photon polymerization},
}

