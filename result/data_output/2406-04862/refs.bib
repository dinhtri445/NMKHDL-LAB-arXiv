@article{Aristov2016,
  year = {2016},
  url = {https://www.nature.com/articles/srep25380},
  volume = {6},
  title = {3D plasmonic crystal metamaterials for ultra-sensitive biosensing},
  publisher = {Nature Publishing Group},
  pmid = {27151104},
  pages = {1-8},
  month = {5},
  keywords = {Biosensors,Nanosensors},
  journal = {Scientific Reports 2016 6:1},
  issue = {1},
  issn = {2045-2322},
  doi = {10.1038/srep25380},
  author = {Andrey I. Aristov and Maria Manousidaki and Artem Danilov and Konstantina Terzaki and Costas Fotakis and Maria Farsari and Andrei V. Kabashin},
  abstract = {We explore the excitation of plasmons in 3D plasmon crystal metamaterials and report the observation of a delocalized plasmon mode, which provides extremely high spectral sensitivity (&gt;2600nm per refractive index unit (RIU) change), outperforming all plasmonic counterparts excited in 2D nanoscale geometries, as well as a prominent phase-sensitive response (&gt;3*104 deg. of phase per RIU). Combined with a large surface for bioimmobilization provided by the 3D matrix, the proposed sensor architecture promises a new important landmark in the advancement of plasmonic biosensing technology.},
}

@article{Vasilantonakis2012,
  year = {2012},
  url = {https://onlinelibrary.wiley.com/doi/full/10.1002/adma.201104778 https://onlinelibrary.wiley.com/doi/abs/10.1002/adma.201104778 https://onlinelibrary.wiley.com/doi/10.1002/adma.201104778},
  volume = {24},
  title = {Three-Dimensional Metallic Photonic Crystals with Optical Bandgaps},
  publisher = {John Wiley & Sons, Ltd},
  pmid = {22278944},
  pages = {1101-1105},
  month = {2},
  journal = {Advanced Materials},
  issue = {8},
  issn = {1521-4095},
  doi = {10.1002/ADMA.201104778},
  author = {Nikos Vasilantonakis and Konstantina Terzaki and Ioanna Sakellari and Vytautas Purlys and David Gray and Costas M. Soukoulis and Maria Vamvakaki and Maria Kafesaki and Maria Farsari},
  abstract = {The fabrication of fully three-dimensional photonic crystals with a bandgap at optical wavelengths is demonstrated by way of direct femtosecond laser writing of an organic-inorganic hybrid material with metal-binding moieties, and selective silver coating using electroless plating. The crystals have 600-nm intralayer periodicity and sub-100 nm features, and they exhibit well-defined diffraction patterns. Copyright © 2012 WILEY-VCH Verlag GmbH & Co. KGaA, Weinheim.},
}

