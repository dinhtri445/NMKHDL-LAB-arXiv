  journal = {Journal of Applied Physics},
  urldate = {2023-09-11},
  number = {8},
  language = {en},
  abstract = {We have developed a simple method to measure the transport spin polarization of ferromagnetic materials. This technique relies on the fact that the Andreev reflection process at the interface between a superconductive and normal is influenced by the spin polarization P of the normal metal. In a very short time we have been able to measure the spin polarization of several metals: NixFe1−x, Ni, Co, Fe, NiMnSb, La0.7Sr0.3MnO3, and CrO2, whose spin polarization ranges from 35% to 90%. Our results compare well with other methods for measuring P.},
  doi = {10.1063/1.370417},
  url = {https://pubs.aip.org/jap/article/85/8/4589/490444/Andreev-reflection-A-new-means-to-determine-the},
  shorttitle = {Andreev reflection},
  issn = {0021-8979, 1089-7550},
  volume = {85},
  title = {Andreev reflection: A new means to determine the spin polarization of ferromagnetic materials},
}

