@article{tuckerman2018preface,
  file = {D:\\Data\\Zotero\\storage\\FKVD3EPZ\\Tuckerman and Ceperley - 2018 - Preface Special Topic on Nuclear Quantum Effects.pdf},
  langid = {english},
  abstract = {Although the observable universe strictly obeys the laws of quantum mechanics, in many instances, a classical description that either ignores quantum effects entirely or accounts for them at a very crude level is sufficient to describe a wide variety of phenomena. However, when this approximation breaks down, as is often the case for processes involving light nuclei, a full quantum treatment becomes indispensable. This Special Topic in The Journal of Chemical Physics showcases recent advances in our understanding of nuclear quantum effects in condensed phases as well as novel algorithmic developments and applications that have enhanced the capability to study these effects.},
