@article{andreani2001single,
  file = {D:\\Data\\Zotero\\storage\\YSVQJC87\\Andreani et al. - 2001 - Single particle dynamics in fluid and solid hydrog.pdf},
  langid = {english},
  abstract = {Inelastic neutron scattering experiments were performed at intermediate and high momentum transfer, up to 88.2$ \\Angstroem-$1, to study the temperature dependence of single hydrogen mean kinetic energy in polycrystalline and liquid hydrogen sulphide (H2S), in the temperature range 16--206 K. Values of the hydrogen mean kinetic energy were extracted, within the impulse approximation, by fitting to the high momentum transfer data a model response function, obtained from a momentum distribution which is the orientational average of a multivariate Gaussian function. The extracted kinetic energies are compared with a harmonic model for the vibrational and roto-translational dynamics. The model makes use of the hydrogen-projected density of states worked out from intermediate momentum transfer data, as well as of optical frequencies determined from Raman and infrared (IR) spectroscopy. A fairly good agreement is obtained in the whole temperature range, while noticeably lower values for the kinetic energy are found if a single atom momentum distribution of isotropic Gaussian shape is assumed in the model response function.},
  urldate = {2024-05-04},
  doi = {10.1063/1.1329139},
  issn = {0021-9606, 1089-7690},
  pages = {387--398},
  number = {1},
  volume = {114},
  journal = {The Journal of Chemical Physics},
  month = {January},
  year = {2001},
  author = {Andreani, C. and Degiorgi, E. and Senesi, R. and Cilloco, F. and Colognesi, D. and Mayers, J. and Nardone, M. and Pace, E.},
  shorttitle = {Single Particle Dynamics in Fluid and Solid Hydrogen Sulphide},
  title = {Single Particle Dynamics in Fluid and Solid Hydrogen Sulphide: An Inelastic Neutron Scattering Study},
}

