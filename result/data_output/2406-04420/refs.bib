@article{KUHN2015374,
  pages = {374-384},
  year = {2015},
  volume = {108},
  journal = {Computational Materials Science},
  title = {On degradation functions in phase field fracture models},
  author = {Kuhn, C. and Schlüter, A. and M\\l̈ler, R.},
  abstract = {Unlike the description of cracks as sharp surfaces which requires different criteria to predict the onset of crack propagation, the direction of crack growth, possible crack branching, and the nucleation of new cracks, the phase field approach provides a holistic description of all these fracture processes. The phase field order parameter is used to differentiate between broken and undamaged material, and the entire crack evolution is obtained implicitly by solving the evolution equation of the order parameter which is coupled to the mechanical field equations. A so called degradation function couples the order parameter to the elastic properties of the material in order to model the change in stiffness between fractured and undamaged material. The nucleation of a new crack in originally undamaged material is preceded by a localization of the fracture field. Before the onset of this localization the material response of the phase field fracture model is mainly controlled by the degradation function. However, the degradation function frequently found in the literature yields a pronounced softening behavior before the onset of fracture which is not desirable when modeling brittle materials. In this work we discuss the potential of alternative degradation functions in the context of crack nucleation and propagation.},
  keywords = {Brittle fracture, Phase field modeling, Finite elements, Crack nucleation},
  url = {https://www.sciencedirect.com/science/article/pii/S0927025615003602},
  doi = {https://doi.org/10.1016/j.commatsci.2015.05.034},
  issn = {0927-0256},
  note = {Selected Articles from Phase-field Method 2014 International Seminar},
}

