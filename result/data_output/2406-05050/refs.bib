@inbook{Branch2017,
  url = {https://doi.org/10.1007/978-3-662-55054-0_20},
  doi = {10.1007/978-3-662-55054-0_20},
  isbn = {978-3-662-55054-0},
  abstract = {In this chapter describes the observational properties of supernovae of Type Ia (SN Ia). These events occur not only in young stellar populations but also in old ones, indicating that they do not arise from core collapse in massive stars. The observational properties of typical SN Ia are remarkably homogeneous. Spectroscopic analysis indicates that the composition of the ejected matter varies from primarily elements of intermediate mass such as oxygen and silicon in the outer layers to iron-group elements in deeper layers. The decay products of radioactive nickel-56 and its daughter, cobalt-56, power the light curves. Some SN Ia, called SN 1991T-likes and SN 1991bg-likes, show clear differences from typical SN Ia, and even typical events display some diversity. To an extent, the observational properties are correlated such that SN Ia can be arranged in a single-parameter sequence, but more of the diversity is captured by multiparameter subclassification. The common interpretation of SN Ia is that they are the complete thermonuclear disruptions of carbon-oxygen white dwarfs that accrete from a binary companion until they approach the Chandrasekhar mass, 1.4 solar masses. Modern observations suggest that a significant fraction of SN Ia eject less than 1.4 solar masses, while a small fraction eject more.},
  pages = {483--517},
  address = {Berlin, Heidelberg},
  publisher = {Springer Berlin Heidelberg},
  year = {2017},
  booktitle = {Supernova Explosions},
  title = {Observational Properties},
  author = {Branch, David
and Wheeler, J. Craig},
}

