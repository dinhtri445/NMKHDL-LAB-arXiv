@article{waller_phase_2010,
  file = {Full Text PDF:/home/gabriel/snap/zotero-snap/common/Zotero/storage/MMKLLYU3/Waller et al. - 2010 - Phase from chromatic aberrations.pdf:application/pdf},
  pages = {22817--22825},
  keywords = {Chromatic aberration, Imaging systems, Phase contrast, Phase recovery, Real time imaging, Spatial resolution},
  note = {Publisher: Optica Publishing Group},
  year = {2010},
  month = {October},
  author = {Waller, Laura and Kou, Shan Shan and Sheppard, Colin J. R. and Barbastathis, George},
  journal = {Optics Express},
  urldate = {2024-02-12},
  number = {22},
  language = {EN},
  abstract = {We show that phase objects may be computed accurately from a single color image in a brightfield microscope, with no hardware modification. Our technique uses the chromatic aberration that is inherent to every lens-based imaging system as a phase contrast mechanism. This leads to a simple and inexpensive way of achieving single-shot quantitative phase recovery by a modified Transport of Intensity Equation (TIE) solution, allowing real-time phase imaging in a traditional microscope.},
