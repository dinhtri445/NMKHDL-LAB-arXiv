@article{Ding21a,
  bdsk-file-1 = {},
  year = {2021},
  volume = {921},
  url = {https://doi.org/10.3847/2041-8213/ac3091},
  title = {The Orbital-decay Test of General Relativity to the 2% Level with 6 yr VLBA Astrometry of the Double Neutron Star PSR J1537$\\mathplus$1155},
  publisher = {American Astronomical Society},
  pages = {L19},
  number = {1},
  month = {nov},
  journal = {\\apjl},
  doi = {10.3847/2041-8213/ac3091},
  date-modified = {2022-05-17 14:35:04 +0800},
  date-added = {2021-11-03 01:35:08 +1100},
  author = {Hao Ding and Adam T. Deller and Emmanuel Fonseca and Ingrid H. Stairs and Benjamin Stappers and Andrew Lyne},
  abstract = {PSR J1537+1155, also known as PSR B1534+12, is the second discovered double neutron star (DNS) binary. More than 20 yr of timing observations of PSR J1537+1155 have offered some of the most precise tests of general relativity (GR) in the strong-field regime. As one of these tests, the gravitational-wave emission predicted by GR has been probed with the significant orbital decay () of PSR J1537+1155. However, compared to most GR tests provided with the post-Keplerian parameters, the orbital-decay test was lagging behind in terms of both precision and consistency with GR, limited by the uncertain distance of PSR J1537+1155. With an astrometric campaign spanning 6 yr using the Very Long Baseline Array, we measured an annual geometric parallax of 1.063 $±$ 0.075 mas for PSR J1537+1155, corresponding to a distance of kpc. This is the most tightly constrained model-independent distance achieved for a DNS to date. After obtaining (i.e., the orbital decay caused by Galactic gravitational potential) with a combination of four Galactic mass distribution models, we updated the ratio of the observed intrinsic orbital decay to the GR prediction to 0.977 $±$ 0.020, three times more precise than the previous orbital-decay test (0.91 $±$ 0.06) made with PSR J1537+1155.},
}

