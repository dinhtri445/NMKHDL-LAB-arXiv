@misc{NoteRef28,
  note = {\\bibinfo{note}{Note that in the non-equilibrium model of Ref.~\\cite{Sliusarenko2010}, the correlation function decays as $\\langle x(t)x(0)\\rangle\\sim 1/t^\\alpha$ with $\\alpha=2-2H$, where $H$ is defined so that $\\langle x^2\\rangle\\propto t^{2H}$ in absence of potential. As a consequence, the long-term memory property $\\alpha<1$ corresponds to $H>1/2$, with an infinite mean FPT predicted by the Wilemski-Fixman approximation.}},
}

