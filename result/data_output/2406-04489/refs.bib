  journal = {High Power Laser Science and Engineering},
  author = {Zhu, Jianqiang and Zhu, Jian and Li, Xuechun and Zhu, Baoqiang and Ma, Weixin and Lu, Xingqiang and Fan, Wei and Liu, Zhigang and Zhou, Shenlei and Xu, Guang and et al.},
